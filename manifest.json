{
  "schema": 1,
  "name": "@razureink/0kay-free-model",
  "version": "0.0.8",
  "description": "Our Free Model — the opencode Zen free model lane (MiMo V2.6, Muse Spark 1.3, …) as a 0KAY provider. Hosted by Core over stdio (no port). No account, no API key.",
  "repository": "https://github.com/razureink/0KAY-free-model.git",
  "requires": [],
  "provider": {
    "id": "opencode-free",
    "name": "Our Free Model",
    "route": "/v1",
    "stdio": ["node", "src/stdio.mjs"],
    "models": [
      "jev-1.13-free",
      "deepseek-v4-flash-free",
      "muse-spark-1.3-contributor-free",
      "muse-spark-1.2-contributor-free",
      "mimo-v2.6-flash-free",
      "space-bunny-free",
      "longcat-2.5-preview-free",
      "mimo-v2.5-free",
      "ling-3.0-flash-fin-free",
      "nemotron-3-ultra-free",
      "nemotron-3.5-lightning-free"
    ]
  },
  "permissions": {
    "egress": ["opencode.ai", "*.opencode.ai"]
  }
}
